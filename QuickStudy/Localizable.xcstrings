    "Choose Not now and every draft stays on-device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis « Pas maintenant » et chaque brouillon reste sur l’appareil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Nicht jetzt“, dann bleibt jeder Entwurf auf dem Gerät."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今はしない」を選ぶと、すべての作成がデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘나중에’를 선택하면 모든 초안이 기기 내에서 작성돼요."
