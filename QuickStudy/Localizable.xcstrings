      "shouldTranslate" : false
    },
    "Apple Intelligence couldn't process part of this document, so those sections have no cards. Pro drafts with QuickStudy's cloud model instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence n’a pas pu traiter une partie de ce document, donc ces sections n’ont pas de cartes. Pro rédige à la place avec le modèle cloud de QuickStudy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence konnte einen Teil dieses Dokuments nicht verarbeiten, daher haben diese Abschnitte keine Karten. Mit Pro erstellt das Cloud-Modell von QuickStudy stattdessen die Entwürfe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceでこの書類の一部を処理できなかったため、そのセクションにはカードがありません。Proでは、代わりにQuickStudyのクラウドモデルで作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 이 문서의 일부를 처리하지 못해 해당 부분에는 카드가 없어요. Pro는 대신 QuickStudy의 클라우드 모델로 초안을 만들어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence não conseguiu processar parte deste documento, então essas seções ficaram sem cartões. O Pro cria os cartões com o modelo na nuvem do QuickStudy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no pudo procesar una parte de este documento, así que esas secciones no tienen tarjetas. Pro redacta con el modelo en la nube de QuickStudy."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no ha podido procesar una parte de este documento, así que esas secciones no tienen tarjetas. Pro redacta con el modelo en la nube de QuickStudy."
          }
        }
      }
    },
    "Apple Intelligence is still downloading. Try again in a few minutes." : {
