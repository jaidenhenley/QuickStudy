          }
        }
      }
    },
    "This iPhone can’t draft cards on its own. Your text is sent to Apple’s Private Cloud Compute or to QuickStudy’s server, which uses Anthropic’s Claude. Claude deletes it within 30 days." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas rédiger de cartes seul. Ton texte est envoyé à Private Cloud Compute d’Apple ou au serveur de QuickStudy, qui utilise Claude d’Anthropic. Claude le supprime sous 30 jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann Karten nicht allein erstellen. Dein Text wird an Apples Private Cloud Compute oder an den Server von QuickStudy gesendet, der Claude von Anthropic nutzt. Claude löscht ihn innerhalb von 30 Tagen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneだけではカードを作成できません。テキストはAppleのPrivate Cloud Compute、またはAnthropicのClaudeを使用するQuickStudyのサーバに送信されます。Claudeは30日以内にテキストを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 자체적으로 카드 초안을 만들 수 없어요. 텍스트는 Apple의 Private Cloud Compute 또는 Anthropic의 Claude를 사용하는 QuickStudy 서버로 전송돼요. Claude는 30일 이내에 텍스트를 삭제해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não consegue criar cartões sozinho. Seu texto é enviado ao Private Cloud Compute da Apple ou ao servidor do QuickStudy, que usa o Claude, da Anthropic. O Claude apaga o texto em até 30 dias."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede redactar tarjetas por sí solo. Tu texto se envía a Private Cloud Compute de Apple o al servidor de QuickStudy, que usa Claude de Anthropic. Claude lo elimina en un plazo de 30 días."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede redactar tarjetas por sí solo. Tu texto se envía a Private Cloud Compute de Apple o al servidor de QuickStudy, que usa Claude de Anthropic. Claude lo elimina en un plazo de 30 días."
          }
        }
      }
    },
    "This iPhone couldn't verify with QuickStudy. Try again in a moment." : {
