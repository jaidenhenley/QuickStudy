    "Cards are generated on QuickStudy's server with Anthropic's Claude, which deletes your text within 30 days." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes sont générées sur le serveur de QuickStudy avec Claude d’Anthropic, qui supprime ton texte sous 30 jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten werden auf dem Server von QuickStudy mit Claude von Anthropic erstellt. Claude löscht deinen Text innerhalb von 30 Tagen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードはQuickStudyのサーバでAnthropicのClaudeによって生成されます。Claudeは30日以内にテキストを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드는 QuickStudy 서버에서 Anthropic의 Claude로 생성되며, Claude는 30일 이내에 텍스트를 삭제해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões são gerados no servidor do QuickStudy com o Claude, da Anthropic, que apaga seu texto em até 30 dias."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas se generan en el servidor de QuickStudy con Claude de Anthropic, que elimina tu texto en un plazo de 30 días."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas se generan en el servidor de QuickStudy con Claude de Anthropic, que elimina tu texto en un plazo de 30 días."
          }
        }
      }
    },
