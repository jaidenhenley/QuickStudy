            "value" : "Ce brouillon sera supprimé. Cela a utilisé une de tes générations gratuites."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Entwurf wird gelöscht. Dabei wurde eine deiner kostenlosen Generierungen verbraucht."
          }
        },
        "ja" : {
          "stringUnit" : {
