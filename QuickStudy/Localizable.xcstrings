    "Your notes will be sent to your chosen provider using your key, under that provider's privacy policy." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes notes seront envoyées au fournisseur que tu as choisi avec ta clé, selon la politique de confidentialité de ce fournisseur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen werden mit deinem Schlüssel an den gewählten Anbieter gesendet, gemäß dessen Datenschutzrichtlinie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートはあなたのキーを使って選択したプロバイダに送信され、そのプロバイダのプライバシーポリシーが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
