    "No text was detected. Try better lighting, hold steady, or fill the frame with the page." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun texte détecté. Essaie avec un meilleur éclairage, tiens l’appareil bien stable ou cadre toute la page."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde kein Text erkannt. Sorge für besseres Licht, halte ruhig oder fülle den Rahmen mit der Seite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストが検出されませんでした。明るい場所で、カメラを動かさずに、ページが画面いっぱいに入るように撮影してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
