          }
        }
      }
    },
    "Your saved sets couldn't be opened right now. Changes won't be saved until you restart QuickStudy." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir tes paquets enregistrés pour le moment. Les modifications ne seront pas enregistrées tant que tu n’auras pas redémarré QuickStudy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gesicherten Sets konnten gerade nicht geöffnet werden. Änderungen werden erst nach einem Neustart von QuickStudy gesichert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したセットを現在開けません。QuickStudyを再起動するまで、変更は保存されません。"
          }
