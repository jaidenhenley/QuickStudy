    "Couldn't find enough about %@ in this set to make new cards." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de contenu sur %@ dans ce paquet pour créer de nouvelles cartes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Set wurde nicht genug zu %@ gefunden, um neue Karten zu erstellen."
