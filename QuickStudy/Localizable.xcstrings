          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas anotações serão enviadas ao provedor escolhido usando sua chave, sob a política de privacidade desse provedor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
