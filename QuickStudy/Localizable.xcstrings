    "You now have %lld cloud generations a month. Long documents count as one generation per %@ characters." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You now have %1$lld cloud generations a month. Long documents count as one generation per %2$@ characters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as maintenant %1$lld générations cloud par mois. Les longs documents comptent pour une génération par tranche de %2$@ caractères."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast jetzt %1$lld Cloud-Generierungen pro Monat. Lange Dokumente zählen als eine Generierung pro %2$@ Zeichen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月%1$lld回のクラウド生成を利用できるようになりました。長い書類は%2$@文字ごとに1回の生成として数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 매월 클라우드 생성 %1$lld회를 사용할 수 있어요. 긴 문서는 %2$@자마다 생성 1회로 계산돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora você tem %1$lld gerações na nuvem por mês. Documentos longos contam como uma geração a cada %2$@ caracteres."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora tienes %1$lld generaciones en la nube al mes. Los documentos largos cuentan como una generación por cada %2$@ caracteres."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora tienes %1$lld generaciones en la nube al mes. Los documentos largos cuentan como una generación por cada %2$@ caracteres."
          }
        }
      }
    },
