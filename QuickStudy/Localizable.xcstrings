    "Auto-applies if you miss a day. Earn one per full study week." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique automatiquement si tu rates un jour. Gagnes-en un par semaine d’étude complète."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greift automatisch, wenn du einen Tag verpasst. Du verdienst einen pro voller Lernwoche."
