    "Nothing read so far will be kept. To draft these cards later, import it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de ce qui a été lu ne sera conservé. Pour rédiger ces cartes plus tard, importe-le de nouveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
