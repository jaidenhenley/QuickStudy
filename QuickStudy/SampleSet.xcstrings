        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹색광을 흡수하고 적색광을 반사하는 색소"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pigmento que absorve luz verde e reflete luz vermelha."
          }
        }
      }
    },
