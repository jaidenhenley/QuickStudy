          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光合成速度は、光の強さ、二酸化炭素濃度、温度の影響を受ける。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광합성 속도는 빛의 세기, 이산화 탄소 농도, 온도에 따라 달라진다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A taxa de fotossíntese depende da intensidade luminosa, da concentração de gás carbônico e da temperatura."
          }
        }
      }
    },
