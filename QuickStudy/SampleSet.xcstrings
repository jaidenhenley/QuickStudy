    "Splitting water in the light reactions frees the oxygen. The carbon from carbon dioxide ends up in sugar instead." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al descomponerse el agua en las reacciones dependientes de la luz, se libera el oxígeno. En cambio, el carbono del dióxido de carbono termina formando parte del azúcar."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al descomponerse el agua en las reacciones dependientes de la luz, se libera el oxígeno. En cambio, el carbono del dióxido de carbono termina formando parte del azúcar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la décomposition de l’eau, pendant la phase photochimique, qui libère le dioxygène. Le carbone du dioxyde de carbone, lui, se retrouve dans le sucre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Spaltung von Wasser in den lichtabhängigen Reaktionen wird der Sauerstoff frei. Der Kohlenstoff aus dem Kohlenstoffdioxid wird dagegen in Zucker eingebaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光化学反応で水が分解されると、酸素が生じる。一方、二酸化炭素の炭素は糖に取り込まれる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명반응에서 물이 분해될 때 산소가 방출된다. 반면 이산화 탄소의 탄소는 당에 포함된다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quebra da água na fase fotoquímica libera o oxigênio. Já o carbono do gás carbônico é incorporado ao açúcar."
          }
        }
      }
    },
    "Stomata open on the leaf surface so gases can move in and out." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estomas se abren en la superficie de la hoja para que los gases puedan entrar y salir."
