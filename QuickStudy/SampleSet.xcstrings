        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식물은 햇빛을 흡수하고, 그 에너지를 나중에 쓸 수 있도록 당의 화학 결합에 저장한다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As plantas captam a luz do sol e armazenam essa energia nas ligações de um açúcar que podem usar depois."
          }
        }
      }
    },
