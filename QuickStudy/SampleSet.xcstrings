{
  "sourceLanguage" : "en",
  "strings" : {
    "A pigment that absorbs green light and reflects red light." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pigmento que absorbe la luz verde y refleja la luz roja."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pigmento que absorbe la luz verde y refleja la luz roja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pigment qui absorbe la lumière verte et réfléchit la lumière rouge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Farbstoff, der grünes Licht absorbiert und rotes Licht reflektiert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑色光を吸収して赤色光を反射する色素"
