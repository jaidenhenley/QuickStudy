        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quebrar a glicose para liberar energia."
          }
        }
      }
    },
    "Carbon dioxide enters the leaf through small pores called stomata, and water is carried up from the roots through the xylem." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dióxido de carbono entra a la hoja a través de pequeños poros llamados estomas, y el agua sube desde las raíces por el xilema."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dióxido de carbono entra en la hoja a través de pequeños poros llamados estomas, y el agua sube desde las raíces por el xilema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dioxyde de carbone entre dans la feuille par de petits pores appelés stomates, et l’eau monte depuis les racines par le xylème."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohlenstoffdioxid gelangt durch kleine Poren, die Spaltöffnungen (Stomata), in das Blatt, und Wasser wird von den Wurzeln durch das Xylem nach oben transportiert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二酸化炭素は気孔と呼ばれる小さな穴から葉に取り込まれ、水は根から道管を通って運ばれる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이산화 탄소는 기공이라는 작은 구멍을 통해 잎으로 들어오고, 물은 뿌리에서 물관을 통해 위로 운반된다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gás carbônico entra na folha por pequenos poros chamados estômatos, e a água sobe das raízes pelo xilema."
          }
        }
      }
    },
    "Carbon dioxide only." : {
