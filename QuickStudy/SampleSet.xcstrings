    "Breaking down glucose to release energy." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degradar la glucosa para liberar energía."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degradar la glucosa para liberar energía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dégradation du glucose pour libérer de l’énergie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abbau von Glucose, um Energie freizusetzen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グルコースを分解してエネルギーを取り出すこと"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포도당을 분해하여 에너지를 방출하는 것"
